<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.salary.admin.mapper.ext.salary.SalaryDeductionDetailExtMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.salary.admin.model.entity.salary.SalaryDeductionDetail">
        <id column="id" property="id"/>
        <result column="period_id" property="periodId"/>
        <result column="employee_id" property="employeeId"/>
        <result column="deduction_type_id" property="deductionTypeId"/>
        <result column="deduction_type_name" property="deductionTypeName"/>
        <result column="category_name" property="categoryName"/>
        <result column="currency" property="currency"/>
        <result column="original_amount" property="originalAmount"/>
        <result column="exchange_rate" property="exchangeRate"/>
        <result column="amount" property="amount"/>
        <result column="settlement_currency" property="settlementCurrency" />
        <result column="remark" property="remark"/>
        <result column="delete_flag" property="deleteFlag"/>
        <result column="create_by" property="createBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_by" property="updateBy"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id
        , period_id, employee_id,deduction_type_id,deduction_type_name, category_name,currency,original_amount,exchange_rate,amount,settlement_currency, remark, delete_flag, create_by, create_time, update_by, update_time
    </sql>

    <!-- 物理删除：直接删除记录 -->
    <delete id="physicalDeleteById">
        DELETE
        FROM salary_deduction_detail
        WHERE id = #{id}
    </delete>
    <!-- 批量物理删除 -->
    <delete id="physicalDeleteByIds">
        DELETE FROM salary_deduction_detail WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </delete>
    <!-- 自定义多表关联分页查询扣款明细 -->
    <select id="selectDeductionDetailByPage" resultType="com.salary.admin.model.vo.salary.deductiondetail.DeductionDetailVO">
        SELECT
        d.*,
        e.employee_name,
        e.employee_code,
        p.settlement_month
        FROM salary_deduction_detail d
        LEFT JOIN salary_employee e ON d.employee_id = e.id
        LEFT JOIN salary_period p ON d.period_id = p.id
        <where>
            d.delete_flag = 0

            <if test="req.periodId != null">
                AND d.period_id = #{req.periodId}
            </if>

            <if test="req.employeeId != null">
                AND d.employee_id = #{req.employeeId}
            </if>

            <if test="req.deductionTypeId != null">
                AND d.deduction_type_id = #{req.deductionTypeId}
            </if>

            <if test="req.settlementMonth != null and req.settlementMonth != ''">
                AND p.settlement_month = #{req.settlementMonth}
            </if>
        </where>
        ORDER BY d.create_time DESC
    </select>
</mapper>
