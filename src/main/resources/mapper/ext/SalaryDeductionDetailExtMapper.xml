<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.salary.admin.mapper.ext.salary.SalaryDeductionDetailExtMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.salary.admin.model.entity.salary.SalaryDeductionDetail">
        <id column="id" property="id" />
        <result column="period_id" property="periodId" />
        <result column="employee_id" property="employeeId" />
        <result column="deduction_type_id" property="deductionTypeId" />
        <result column="deduction_type_name" property="deductionTypeName" />
        <result column="category_name" property="categoryName" />
        <result column="currency" property="currency" />
        <result column="original_amount" property="originalAmount" />
        <result column="exchange_rate" property="exchangeRate" />
        <result column="amount" property="amount" />
        <result column="remark" property="remark" />
        <result column="delete_flag" property="deleteFlag" />
        <result column="create_by" property="createBy" />
        <result column="create_time" property="createTime" />
        <result column="update_by" property="updateBy" />
        <result column="update_time" property="updateTime" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, period_id, employee_id,deduction_type_id,deduction_type_name, category_name,currency,original_amount,exchange_rate,amount, remark, delete_flag, create_by, create_time, update_by, update_time
    </sql>

    <!-- 物理删除：直接删除记录 -->
    <delete id="physicalDeleteById">
        DELETE FROM salary_deduction_detail WHERE id = #{id}
    </delete>
    <!-- 批量物理删除 -->
    <delete id="physicalDeleteByIds">
        DELETE FROM salary_deduction_detail WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </delete>
</mapper>
