<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.salary.admin.mapper.ext.SalaryCalcPipelineStepExtMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.salary.admin.model.entity.salary.SalaryCalcPipelineStep">
        <id column="id" property="id"/>
        <result column="pipeline_code" property="pipelineCode"/>
        <result column="pipeline_version" property="pipelineVersion"/>
        <result column="rule_code" property="ruleCode"/>
        <result column="rule_name" property="ruleName"/>
        <result column="rule_type" property="ruleType"/>
        <result column="condition_script" property="conditionScript"/>
        <result column="stage" property="stage"/>
        <result column="sort_order" property="sortOrder"/>
        <result column="block_flag" property="blockFlag"/>
        <result column="skip_if_null" property="skipIfNull"/>
        <result column="status" property="status"/>
        <result column="delete_flag" property="deleteFlag"/>
        <result column="create_by" property="createBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_by" property="updateBy"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, pipeline_code, pipeline_version, rule_code, rule_name, rule_type,
        condition_script, stage, sort_order, block_flag, skip_if_null,
        status, delete_flag, create_by, create_time, update_by, update_time
    </sql>


    <!-- 物理删除：直接删除记录 -->
    <delete id="physicalDeleteById">
        DELETE FROM salary_calc_pipeline_step WHERE id = #{id}
    </delete>

    <!-- 批量物理删除 -->
    <delete id="physicalDeleteByIds">
        DELETE FROM salary_calc_pipeline_step
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
