<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.salary.admin.mapper.ext.SalaryCalcLogExtMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.salary.admin.model.entity.salary.SalaryCalcLog">
        <id column="id" property="id" />
        <result column="employee_id" property="employeeId" />
        <result column="period_id" property="periodId" />
        <result column="rule_code" property="ruleCode" />
        <result column="stage" property="stage" />
        <result column="input_json" property="inputJson" />
        <result column="output_value" property="outputValue" />
        <result column="error_msg" property="errorMsg" />
        <result column="execute_time" property="executeTime" />
        <result column="delete_flag" property="deleteFlag" />
        <result column="create_by" property="createBy" />
        <result column="create_time" property="createTime" />
        <result column="update_by" property="updateBy" />
        <result column="update_time" property="updateTime" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, employee_id, period_id, rule_code, stage, input_json, output_value, error_msg, execute_time, delete_flag, create_by, create_time, update_by, update_time
    </sql>
    <!-- 物理删除：直接删除记录 -->
    <delete id="physicalDeleteById">
        DELETE FROM salary_calc_log WHERE id = #{id}
    </delete>

    <!-- 批量物理删除 -->
    <delete id="physicalDeleteByIds">
        DELETE FROM salary_calc_log
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
