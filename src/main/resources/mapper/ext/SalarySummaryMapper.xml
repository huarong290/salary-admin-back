<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.salary.admin.mapper.ext.SalarySummaryExtMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.salary.admin.model.entity.salary.SalarySummary">
        <id column="id" property="id" />
        <result column="employee_id" property="employeeId" />
        <result column="employee_code" property="employeeCode" />
        <result column="employee_name" property="employeeName" />
        <result column="period_id" property="periodId" />
        <result column="settlement_month" property="settlementMonth" />
        <result column="period_start_date" property="periodStartDate" />
        <result column="period_end_date" property="periodEndDate" />
        <result column="income_total" property="incomeTotal" />
        <result column="deduction_total" property="deductionTotal" />
        <result column="tax_total" property="taxTotal" />
        <result column="gross_salary" property="grossSalary" />
        <result column="net_salary" property="netSalary" />
        <result column="manual_payment_amount" property="manualPaymentAmount" />
        <result column="calc_version" property="calcVersion" />
        <result column="calc_status" property="calcStatus" />
        <result column="payment_status" property="paymentStatus" />
        <result column="lock_flag" property="lockFlag" />
        <result column="detail_json" property="detailJson" />
        <result column="remark" property="remark" />
        <result column="delete_flag" property="deleteFlag" />
        <result column="create_by" property="createBy" />
        <result column="create_time" property="createTime" />
        <result column="update_by" property="updateBy" />
        <result column="update_time" property="updateTime" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, employee_id, employee_code, employee_name, period_id, settlement_month, period_start_date, period_end_date, income_total, deduction_total, tax_total, gross_salary, net_salary,manual_payment_amount, calc_version, calc_status, payment_status, lock_flag, detail_json, remark, delete_flag, create_by, create_time, update_by, update_time
    </sql>
    <select id="selectSummaryPage" resultType="com.salary.admin.model.vo.salary.summary.SalarySummaryVO">
        SELECT
        id,
        employee_id,
        employee_code,
        employee_name,
        settlement_month,
        income_total,
        deduction_total,
        tax_total,
        gross_salary,
        net_salary,
        manual_payment_amount,
        calc_status,
        payment_status,
        lock_flag,
        update_time
        FROM salary_summary
        <where>
            delete_flag = 0
            <if test="query.settlementMonth != null and query.settlementMonth != ''">
                AND settlement_month = #{query.settlementMonth}
            </if>
            <if test="query.calcStatus != null">
                AND calc_status = #{query.calcStatus}
            </if>
            <if test="query.paymentStatus != null">
                AND payment_status = #{query.paymentStatus}
            </if>
            <if test="query.keyword != null and query.keyword != ''">
                AND (
                employee_name LIKE CONCAT('%', #{query.keyword}, '%')
                OR employee_code LIKE CONCAT('%', #{query.keyword}, '%')
                )
            </if>
        </where>
        ORDER BY id DESC
    </select>
</mapper>
