<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.salary.admin.mapper.ext.SalaryEmployeeExtMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.salary.admin.model.entity.salary.SalaryEmployee">
        <id column="id" property="id" />
        <result column="employee_code" property="employeeCode" />
        <result column="employee_name" property="employeeName" />
        <result column="company_name" property="companyName" />
        <result column="department" property="department" />
        <result column="job_title" property="jobTitle" />
        <result column="employment_status" property="employmentStatus" />
        <result column="transfer_flag" property="transferFlag" />
        <result column="accommodation_status" property="accommodationStatus" />
        <result column="entry_date" property="entryDate" />
        <result column="probation_end_date" property="probationEndDate" />
        <result column="actual_leave_date" property="actualLeaveDate" />
        <result column="delete_flag" property="deleteFlag" />
        <result column="create_by" property="createBy" />
        <result column="create_time" property="createTime" />
        <result column="update_by" property="updateBy" />
        <result column="update_time" property="updateTime" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, employee_code, employee_name, company_name, department, job_title,
        employment_status, entry_date, probation_end_date, actual_leave_date,
        transfer_flag, accommodation_status, delete_flag, create_by, create_time, update_by, update_time
    </sql>

    <!-- 物理删除：直接删除记录 -->
    <delete id="physicalDeleteById">
        DELETE FROM salary_employee WHERE id = #{id}
    </delete>

    <!-- 批量物理删除 -->
    <delete id="physicalDeleteByIds">
        DELETE FROM salary_employee
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
