<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.salary.admin.mapper.ext.salary.SalaryIncomeDetailExtMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.salary.admin.model.entity.salary.SalaryIncomeDetail">
        <id column="id" property="id" />
        <result column="period_id" property="periodId" />
        <result column="employee_id" property="employeeId" />
        <result column="income_type_id" property="incomeTypeId" />
        <result column="income_type_name" property="incomeTypeName" />
        <result column="category_name" property="categoryName" />
        <result column="currency" property="currency" />
        <result column="original_amount" property="originalAmount" />
        <result column="exchange_rate" property="exchangeRate" />
        <result column="amount" property="amount" />
        <result column="settlement_currency" property="settlementCurrency" />
        <result column="remark" property="remark" />
        <result column="delete_flag" property="deleteFlag" />
        <result column="create_by" property="createBy" />
        <result column="create_time" property="createTime" />
        <result column="update_by" property="updateBy" />
        <result column="update_time" property="updateTime" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, period_id, employee_id,income_type_id, income_type_name,category_name,currency,original_amount,exchange_rate,amount,settlement_currency, remark, delete_flag, create_by, create_time, update_by, update_time
    </sql>

    <!-- 物理删除：直接删除记录 -->
    <delete id="physicalDeleteById">
        DELETE FROM salary_income_detail WHERE id = #{id}
    </delete>

    <!-- 批量物理删除 -->
    <delete id="physicalDeleteByIds">
        DELETE FROM salary_income_detail
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    <select id="selectIncomeDetailByPage"
            resultType="com.salary.admin.model.vo.salary.incomedetail.IncomeDetailVO">
        SELECT
        i.*,
        e.employee_name,
        e.employee_code,
        p.settlement_month
        FROM salary_income_detail i
        LEFT JOIN salary_employee e ON i.employee_id = e.id
        LEFT JOIN salary_period p ON i.period_id = p.id
        <where>
            i.delete_flag = 0

            <if test="req.periodId != null">
                AND i.period_id = #{req.periodId}
            </if>
            <if test="req.employeeId != null">
                AND i.employee_id = #{req.employeeId}
            </if>
            <if test="req.incomeTypeId != null">
                AND i.income_type_id = #{req.incomeTypeId}
            </if>

            <if test="req.settlementMonth != null and req.settlementMonth != ''">
                AND p.settlement_month = #{req.settlementMonth}
            </if>
        </where>
        ORDER BY i.create_time DESC
    </select>
</mapper>
