<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.salary.admin.mapper.ext.salary.SalarySummaryExtMapper">
    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.salary.admin.model.entity.salary.SalarySummary">
        <id column="id" property="id" />
        <result column="period_id" property="periodId" />
        <result column="currency" property="currency" />
        <result column="exchange_rate" property="exchangeRate" />

        <result column="salary_subtotal" property="salarySubtotal" />
        <result column="salary_deduction_total" property="salaryDeductionTotal" />
        <result column="salary_total" property="salaryTotal" />

        <result column="salary_converted" property="salaryConverted" />
        <result column="salary_rmb" property="salaryRmb" />
        <result column="salary_usdt" property="salaryUsdt" />

        <result column="target_account" property="targetAccount" />
        <result column="payment_status" property="paymentStatus" />
        <result column="pay_time" property="payTime" />

        <result column="remark" property="remark" />
        <result column="delete_flag" property="deleteFlag" />
        <result column="create_by" property="createBy" />
        <result column="create_time" property="createTime" />
        <result column="update_by" property="updateBy" />
        <result column="update_time" property="updateTime" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, period_id, currency, exchange_rate,
        salary_subtotal, salary_deduction_total, salary_total,
        salary_converted, salary_rmb, salary_usdt,
        target_account, payment_status, pay_time,
        remark, delete_flag, create_by, create_time, update_by, update_time
    </sql>

    <!-- 物理删除：直接删除记录 -->
    <delete id="physicalDeleteById">
        DELETE FROM salary_summary WHERE id = #{id}
    </delete>
    <!-- 批量物理删除 -->
    <delete id="physicalDeleteByIds">
        DELETE FROM salary_summary WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </delete>
</mapper>
