<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.salary.admin.mapper.ext.SalaryKpiRecordExtMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.salary.admin.model.entity.salary.SalaryKpiRecord">
        <id column="id" property="id"/>
        <result column="employee_id" property="employeeId"/>
        <result column="period_id" property="periodId"/>
        <result column="settlement_month" property="settlementMonth"/>
        <result column="kpi_grade" property="kpiGrade"/>
        <result column="kpi_score" property="kpiScore"/>
        <result column="kpi_coefficient" property="kpiCoefficient"/>
        <result column="evaluate_by" property="evaluateBy"/>
        <result column="evaluate_remark" property="evaluateRemark"/>
        <result column="audit_status" property="auditStatus"/>
        <result column="effective_flag" property="effectiveFlag"/>
        <result column="taxable_flag" property="taxableFlag"/>
        <result column="delete_flag" property="deleteFlag"/>
        <result column="create_by" property="createBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_by" property="updateBy"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id
        , employee_id, period_id, settlement_month, kpi_grade, kpi_score, kpi_coefficient, evaluate_by, evaluate_remark, audit_status, effective_flag, taxable_flag, delete_flag, create_by, create_time, update_by, update_time
    </sql>


    <select id="selectKpiRecordPage" resultType="com.salary.admin.model.vo.salary.kpi.SalaryKpiRecordVO">
        SELECT
        k.id,
        k.employee_id,
        k.period_id,
        k.settlement_month,
        k.kpi_grade,
        k.kpi_score,
        k.kpi_coefficient,
        k.evaluate_by,
        k.evaluate_remark,
        k.audit_status,
        k.effective_flag,
        k.taxable_flag,
        k.create_time,
        k.update_time,
        e.employee_name,
        e.employee_code,
        e.department AS department_name
        FROM salary_kpi_record k
        LEFT JOIN salary_employee e ON k.employee_id = e.id
        <where>
            k.delete_flag = 0
            AND e.delete_flag = 0
            <!-- 撤回后 effective_flag=0 的单据仍需在列表可见, 以便重新打分审核 -->
            <if test="req.settlementMonth != null and req.settlementMonth != ''">
                AND k.settlement_month = #{req.settlementMonth}
            </if>
            <if test="req.year != null and req.year != ''">
                AND k.settlement_month LIKE CONCAT(#{req.year}, '%')
            </if>
            <if test="req.auditStatus != null">
                AND k.audit_status = #{req.auditStatus}
            </if>
            <if test="req.keyword != null and req.keyword != ''">
                AND (
                e.employee_name LIKE CONCAT('%', #{req.keyword}, '%')
                OR e.employee_code LIKE CONCAT('%', #{req.keyword}, '%')
                )
            </if>
        </where>
        ORDER BY k.create_time DESC
    </select>
</mapper>
