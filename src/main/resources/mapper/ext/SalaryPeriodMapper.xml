<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.salary.admin.mapper.ext.SalaryPeriodExtMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.salary.admin.model.entity.salary.SalaryPeriod">
        <id column="id" property="id" />
        <result column="employee_id" property="employeeId" />
        <result column="work_month" property="workMonth" />
        <result column="settlement_month" property="settlementMonth" />
        <result column="start_date" property="startDate" />
        <result column="end_date" property="endDate" />
        <result column="month_days" property="monthDays" />
        <result column="standard_rest_days" property="standardRestDays" />
        <result column="attendance_days" property="attendanceDays" />
        <result column="office_days" property="officeDays" />
        <result column="wfh_days" property="wfhDays" />
        <result column="unpaid_leave_days" property="unpaidLeaveDays" />
        <result column="paid_leave_days" property="paidLeaveDays" />
        <result column="full_attendance_flag" property="fullAttendanceFlag" />
        <result column="delete_flag" property="deleteFlag" />
        <result column="create_by" property="createBy" />
        <result column="create_time" property="createTime" />
        <result column="update_by" property="updateBy" />
        <result column="update_time" property="updateTime" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, employee_id, work_month, settlement_month, start_date, end_date, month_days,standard_rest_days, attendance_days,office_days,wfh_days,unpaid_leave_days,paid_leave_days, full_attendance_flag, delete_flag, create_by, create_time, update_by, update_time
    </sql>


    <!--
         分页查询薪资周期信息
         返回 PeriodVO 对象，包含周期信息和员工姓名/编号
         支持条件过滤：员工ID、结算月份、关键字（姓名/编号）、部门
     -->
    <select id="selectPeriodPage" resultType="com.salary.admin.model.vo.salary.period.PeriodVO">
        SELECT
        p.id,
        p.employee_id,
        p.work_month,
        p.settlement_month,
        p.start_date,
        p.end_date,
        p.month_days,
        p.standard_rest_days,
        p.attendance_days,
        p.office_days,
        p.wfh_days,
        p.unpaid_leave_days,
        p.paid_leave_days,
        p.full_attendance_flag,
        p.create_time,
        p.update_time,
        p.create_by,
        e.employee_name,
        e.employee_code
        FROM salary_period p
        LEFT JOIN salary_employee e ON p.employee_id = e.id
        <where>
            p.delete_flag = 0
            AND e.delete_flag = 0

            <if test="req.employeeId != null">
                AND p.employee_id = #{req.employeeId}
            </if>

            <if test="req.settlementMonth != null and req.settlementMonth != ''">
                AND p.settlement_month = #{req.settlementMonth}
            </if>

            <if test="req.keyword != null and req.keyword != ''">
                AND (e.employee_name LIKE CONCAT('%', #{req.keyword}, '%')
                OR e.employee_code LIKE CONCAT('%', #{req.keyword}, '%'))
            </if>

            <if test="req.department != null and req.department != ''">
                AND e.department = #{req.department}
            </if>
        </where>
        ORDER BY p.settlement_month DESC, p.create_time DESC
    </select>


    <!-- 物理删除：根据主键 ID 直接删除 salary_period 表中的数据 -->
    <delete id="physicalDeleteById">
        DELETE FROM salary_period WHERE id = #{id}
    </delete>

    <!-- 批量物理删除：根据多个 ID 批量删除 salary_period 表中的数据 -->
    <delete id="physicalDeleteByIds">
        DELETE FROM salary_period WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </delete>
</mapper>
